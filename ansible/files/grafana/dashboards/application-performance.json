{
	"annotations": { "list": [] },
	"editable": false,
	"graphTooltip": 1,
	"links": [],
	"panels": [
		{
			"datasource": "prometheus",
			"fieldConfig": { "defaults": { "min": 0, "unit": "s" }, "overrides": [] },
			"gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
			"id": 1,
			"options": {
				"legend": {
					"calcs": ["lastNotNull"],
					"displayMode": "list",
					"placement": "bottom",
					"showLegend": true
				},
				"tooltip": { "mode": "multi", "sort": "desc" }
			},
			"targets": [
				{
					"datasource": "prometheus",
					"editorMode": "code",
					"expr": "histogram_quantile(0.95, sum by (le, route) (rate(app_http_request_duration_seconds_bucket[5m])))",
					"legendFormat": "{{route}}",
					"range": true,
					"refId": "A"
				}
			],
			"title": "Response Time (p95)",
			"type": "timeseries"
		},
		{
			"datasource": "prometheus",
			"fieldConfig": {
				"defaults": { "max": 100, "min": 0, "unit": "percent" },
				"overrides": []
			},
			"gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
			"id": 2,
			"options": {
				"legend": {
					"calcs": ["lastNotNull"],
					"displayMode": "list",
					"placement": "bottom",
					"showLegend": true
				},
				"tooltip": { "mode": "multi", "sort": "desc" }
			},
			"targets": [
				{
					"datasource": "prometheus",
					"editorMode": "code",
					"expr": "100 * (sum(rate(app_http_requests_total{status_code=~\"5..\"}[5m])) or vector(0)) / clamp_min(sum(rate(app_http_requests_total[5m])), 0.000001)",
					"legendFormat": "Error rate",
					"range": true,
					"refId": "A"
				}
			],
			"title": "HTTP Error Rate",
			"type": "timeseries"
		},
		{
			"datasource": "prometheus",
			"fieldConfig": {
				"defaults": { "decimals": 0, "min": 0, "unit": "short" },
				"overrides": []
			},
			"gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
			"id": 3,
			"options": {
				"legend": {
					"calcs": ["lastNotNull"],
					"displayMode": "list",
					"placement": "bottom",
					"showLegend": true
				},
				"tooltip": { "mode": "multi", "sort": "desc" }
			},
			"targets": [
				{
					"datasource": "prometheus",
					"editorMode": "code",
					"expr": "sum(increase(app_health_checks_total[5m]))",
					"legendFormat": "Health checks",
					"range": true,
					"refId": "A"
				}
			],
			"title": "Custom Metric: Health Checks (5 Minutes)",
			"type": "timeseries"
		}
	],
	"refresh": "15s",
	"schemaVersion": 41,
	"tags": ["sherlock-logs", "application"],
	"templating": { "list": [] },
	"time": { "from": "now-1h", "to": "now" },
	"timezone": "browser",
	"title": "Application Performance Dashboard",
	"uid": "sherlock-application-performance",
	"version": 1
}
